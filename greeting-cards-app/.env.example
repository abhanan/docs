# ---------------------------------------------------------------------------
# Supabase (structured data + realtime)
# ---------------------------------------------------------------------------
# Public project URL + anon key. Safe to expose to the browser; RLS protects
# the data. Used by the realtime client on the live-updating wall.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key. SERVER ONLY — never exposed to the browser. All privileged
# writes (create card, add contribution, record view, expiry job) go through
# API routes using this key, with token checks enforced in code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Cloudflare R2 (photo storage, zero egress)
# R2 is S3-compatible; the AWS S3 SDK talks to it directly.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=greeting-cards
# S3 API endpoint. Usually https://<account_id>.r2.cloudflarestorage.com
# Leave blank to derive it from R2_ACCOUNT_ID.
R2_ENDPOINT=

# Public base URL that photo keys are served from. Either the bucket's public
# r2.dev URL or (recommended) a custom domain bound to the bucket. This is the
# prefix stored in contributors.photo_url and loaded by <img> in the browser.
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public origin, used to build shareable links. e.g. https://cards.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret guarding the daily expiry cron route. Vercel Cron sends this as a
# Bearer token (configured in vercel.json / project settings).
CRON_SECRET=generate-a-long-random-string
